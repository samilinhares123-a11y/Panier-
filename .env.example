# Copie ce fichier en .env.local pour travailler sur ton ordinateur.
# Sur Vercel : Project > Settings > Environment Variables.

# Stripe > Développeurs > Clés API (mode test d'abord : clés en pk_test_ / sk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Stripe > Développeurs > Webhooks > ton endpoint > « Secret de signature » (whsec_...)
STRIPE_WEBHOOK_SECRET=

# Email affiché pour le contact et la garantie
NEXT_PUBLIC_CONTACT_EMAIL=
# Ton email : tu y reçois une alerte à chaque vente
ADMIN_EMAIL=

# Resend (resend.com > API Keys) — facultatif au début
RESEND_API_KEY=
EMAIL_FROM=
# Adresse publique du site, ex. https://panierperdu.fr (facultatif sur Vercel)
NEXT_PUBLIC_SITE_URL=
